{
  "name": "pika",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run tokens && npm run typecheck && npm test && npm run build",
    "tokens": "node scripts/tokens.mjs",
    "scorecard": "tsx scripts/scorecard.ts",
    "check:demo-ready": "tsx scripts/check-demo-ready.ts",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "spike:image": "node scripts/spike-image.mjs",
    "spike:task": "node scripts/spike-task.mjs scripts/fixtures/sections 30",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "geist": "^1.8.2",
    "next": "^16.4.3",
    "openai": "^7.43.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
