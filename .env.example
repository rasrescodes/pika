# Copy to .env and fill in. Never commit .env.
MUBIT_API_KEY=
# Use the base URL your Mubit console's Connect page shows.
MUBIT_BASE_URL=https://api.mubit.ai/openai/v1
MUBIT_ANTHROPIC_URL=https://api.mubit.ai/anthropic
# The big model you route through Mubit (your provider's model ID), for scripts/mubit-smoke.mjs.
MODEL=
# Hard cap on paid model calls per day (each batch = 24 calls). Calls over the cap are refused, never charged.
PIKA_MAX_CALLS_PER_DAY=300
# Loop models. Keep each one fixed once training starts: a changed model is a new Mubit task.
DESCRIBER_MODEL=claude-sonnet-5-5
BUILDER_MODEL=claude-sonnet-5-5
CRITIC_MODEL=claude-sonnet-5-5
