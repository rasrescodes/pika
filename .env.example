# Copy to .env and fill in. Never commit .env.
MUBIT_API_KEY=
# Use the base URL your Mubit console's Connect page shows.
MUBIT_BASE_URL=https://api.mubit.ai/openai/v1
# The big model you route through Mubit (your provider's model ID).
MODEL=
# Hard cap on paid model calls per day (each batch = 24 calls). Calls over the cap are refused, never charged.
PIKA_MAX_CALLS_PER_DAY=300
