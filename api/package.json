{
  "name": "pika-polish",
  "private": true,
  "type": "module",
  "description": "Check a website section against Impeccable's design rules and redesign it with Pika's skills prompt, through Mubit.",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --env-file=../.env server.mjs",
