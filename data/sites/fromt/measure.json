{"texts":[{"text":"fromT shows every font installed on your computer rendering your own text, all at once, right in the browser. It runs on","bbox":{"x":22,"y":50,"w":496,"h":188},"fontFamily":"Inter, \"Inter Fallback\"","fontSize":"14px","fontWeight":"400","letterSpacing":"normal","lineHeight":"20px","textTransform":"none","color":"oklab(0.199998 -0.0104908 -0.0259555 / 0.8)","textAlign":"start"},{"text":"Dramatic","bbox":{"x":460,"y":388,"w":521,"h":124},"fontFamily":"\"DM Serif Display\", \"DM Serif Display Fallback\"","fontSize":"84px","fontWeight":"700","letterSpacing":"0.84px","lineHeight":"84px","textTransform":"none","color":"#ffffff","textAlign":"start"},{"text":"Heavy","bbox":{"x":486,"y":382,"w":467,"h":137},"fontFamily":"\"Archivo Black\", \"Archivo Black Fallback\"","fontSize":"84px","fontWeight":"700","letterSpacing":"0.84px","lineHeight":"84px","textTransform":"none","color":"#ffffff","textAlign":"start"},{"text":"The font files never do: the browser's Local Font Access API renders everything on your machine, and nothing is uploaded","bbox":{"x":34,"y":644,"w":472,"h":132},"fontFamily":"Inter, \"Inter Fallback\"","fontSize":"13px","fontWeight":"400","letterSpacing":"normal","lineHeight":"20px","textTransform":"none","color":"oklab(0.199998 -0.0104908 -0.0259555 / 0.65)","textAlign":"start"},{"text":"Bold","bbox":{"x":515,"y":379,"w":409,"h":142},"fontFamily":"Ultra, \"Ultra Fallback\"","fontSize":"84px","fontWeight":"700","letterSpacing":"0.84px","lineHeight":"84px","textTransform":"none","color":"#ffffff","textAlign":"start"},{"text":"Modern","bbox":{"x":494,"y":387,"w":451,"h":127},"fontFamily":"Righteous, \"Righteous Fallback\"","fontSize":"84px","fontWeight":"700","letterSpacing":"0.84px","lineHeight":"84px","textTransform":"none","color":"#ffffff","textAlign":"start"},{"text":"Elegant","bbox":{"x":505,"y":387,"w":430,"h":126},"fontFamily":"\"Playfair Display\", \"Playfair Display Fallback\"","fontSize":"84px","fontWeight":"700","letterSpacing":"0.84px","lineHeight":"84px","textTransform":"none","color":"#ffffff","textAlign":"start"},{"text":"Playful","bbox":{"x":523,"y":383,"w":394,"h":133},"fontFamily":"Lobster, \"Lobster Fallback\"","fontSize":"84px","fontWeight":"700","letterSpacing":"0.84px","lineHeight":"84px","textTransform":"none","color":"#ffffff","textAlign":"start"},{"text":"Friendly","bbox":{"x":508,"y":393,"w":423,"h":115},"fontFamily":"Nunito, \"Nunito Fallback\"","fontSize":"84px","fontWeight":"700","letterSpacing":"0.84px","lineHeight":"84px","textTransform":"none","color":"#ffffff","textAlign":"start"},{"text":"Warm","bbox":{"x":534,"y":386,"w":372,"h":129},"fontFamily":"Pacifico, \"Pacifico Fallback\"","fontSize":"84px","fontWeight":"700","letterSpacing":"0.84px","lineHeight":"84px","textTransform":"none","color":"#ffffff","textAlign":"start"},{"text":"Rough","bbox":{"x":529,"y":389,"w":382,"h":122},"fontFamily":"\"Permanent Marker\", \"Permanent Marker Fallback\"","fontSize":"84px","fontWeight":"700","letterSpacing":"0.84px","lineHeight":"84px","textTransform":"none","color":"#ffffff","textAlign":"start"},{"text":"Quiet","bbox":{"x":557,"y":380,"w":325,"h":140},"fontFamily":"\"Cormorant Garamond\", \"Cormorant Garamond Fallback\"","fontSize":"84px","fontWeight":"700","letterSpacing":"0.84px","lineHeight":"84px","textTransform":"none","color":"#ffffff","textAlign":"start"},{"text":"Clear","bbox":{"x":533,"y":390,"w":374,"h":120},"fontFamily":"\"Space Mono\", \"Space Mono Fallback\"","fontSize":"84px","fontWeight":"700","letterSpacing":"0.84px","lineHeight":"84px","textTransform":"none","color":"#ffffff","textAlign":"start"},{"text":"Urgent","bbox":{"x":571,"y":390,"w":297,"h":118},"fontFamily":"Oswald, \"Oswald Fallback\"","fontSize":"84px","fontWeight":"700","letterSpacing":"0.84px","lineHeight":"84px","textTransform":"none","color":"#ffffff","textAlign":"start"},{"text":"Raw","bbox":{"x":572,"y":393,"w":296,"h":115},"fontFamily":"\"Rubik Mono One\", \"Rubik Mono One Fallback\"","fontSize"